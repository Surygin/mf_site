## public/.htaccess - универсальный файл для вашей структуры
#
## Включаем mod_rewrite
#RewriteEngine On
#RewriteBase /
#
## Если файл или папка существуют - пропускаем (отдаем статику)
#RewriteCond %{REQUEST_FILENAME} -f [OR]
#RewriteCond %{REQUEST_FILENAME} -d
#RewriteRule ^ - [L]
#
## Все запросы перенаправляем на index.php
## (index.php будет обрабатывать все маршруты)
#RewriteRule ^(.*)$ index_router.php [QSA,L]